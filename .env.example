# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travellers

# NextAuth (v5 uses AUTH_SECRET; keep NEXTAUTH_SECRET for backward compat)
AUTH_SECRET="your secret"
NEXTAUTH_SECRET=" your secret "

NEXTAUTH_URL="http://localhost:3000"

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# 
# REQUIRED APIs (Enable these in Google Cloud Console):
# 1. Maps JavaScript API
# 2. Places API (NEW - Required for address search)
# 3. Directions API
#
# Setup Instructions:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable the APIs listed above
# 4. Go to Credentials → Create Credentials → API Key
# 5. (Recommended) Add restrictions:
#    - Application restrictions: HTTP referrers
#    - Add: localhost:3000, yourdomain.com
#
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org


GEMINI_API_KEY="replace with api"
RESEND_API_KEY="replace-me" # Resend API Key for sending emails (https://resend.com)

GOOGLE_CLIENT_ID = 
GOOGLE_CLIENT_SECRET= 

APPLE_CLIENT_ID=
APPLE_CLEINT_SECRET=

# Pusher Configuration
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="your-pusher-cluster"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-pusher-cluster"
# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting Configuration
#
# Every rule in src/lib/rate-limit-rules.ts can be overridden here. The
# variable names are derived from the rule name, so the table and this file
# cannot drift: `authForgotPassword` -> RATE_LIMIT_AUTH_FORGOT_PASSWORD_LIMIT
# and RATE_LIMIT_AUTH_FORGOT_PASSWORD_WINDOW_SECONDS.
#
# LIMIT is the number of requests allowed per window; WINDOW_SECONDS is the
# length of that window. Both must be positive whole numbers — anything else
# logs a warning at boot and falls back to the default shown below.
#
# Leave a line commented out to use the default. The Redis namespace for each
# rule is deliberately not configurable: changing it would reset live counters.

# --- Authentication ---
RATE_LIMIT_AUTH_SIGNIN_LIMIT=10
RATE_LIMIT_AUTH_SIGNIN_WINDOW_SECONDS=600
RATE_LIMIT_AUTH_SIGNUP_LIMIT=5
RATE_LIMIT_AUTH_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_FORGOT_PASSWORD_LIMIT=3
RATE_LIMIT_AUTH_FORGOT_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_VERIFY_OTP_LIMIT=10
RATE_LIMIT_AUTH_VERIFY_OTP_WINDOW_SECONDS=600
RATE_LIMIT_AUTH_RESEND_OTP_LIMIT=3
RATE_LIMIT_AUTH_RESEND_OTP_WINDOW_SECONDS=600

# Confirming a password reset with a token.
# RATE_LIMIT_AUTH_RESET_PASSWORD_LIMIT=5
# RATE_LIMIT_AUTH_RESET_PASSWORD_WINDOW_SECONDS=900

# Changing a password while signed in.
# RATE_LIMIT_AUTH_CHANGE_PASSWORD_LIMIT=5
# RATE_LIMIT_AUTH_CHANGE_PASSWORD_WINDOW_SECONDS=900

# --- Product endpoints ---

# Gemini calls, billed per request. Tighten this first if costs spike.
# RATE_LIMIT_CHAT_LIMIT=10
# RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# Sending a chat message.
# RATE_LIMIT_MESSAGE_SEND_LIMIT=30
# RATE_LIMIT_MESSAGE_SEND_WINDOW_SECONDS=60

# Sending, accepting and declining connection requests.
# RATE_LIMIT_CONNECTION_ACTION_LIMIT=20
# RATE_LIMIT_CONNECTION_ACTION_WINDOW_SECONDS=60

# Filing moderation reports.
# RATE_LIMIT_USER_REPORT_LIMIT=5
# RATE_LIMIT_USER_REPORT_WINDOW_SECONDS=600
